{
  "name": "ecommerce-vertex-functions",
  "version": "0.9.2",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint . --ext .js,.ts",
    "build": "tsc && node -e \"const fs=require('fs'); const p='../dist/ecommerce-vertex/browser/index.html'; if(fs.existsSync(p)){fs.copyFileSync(p, 'lib/index.html'); console.log('[Build] index.html copiado a functions/lib');}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/secret-manager": "^6.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "mercadopago": "^3.6.1",
    "nodemailer": "^9.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bonjour": "^3.5.13",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^8.0.1",
    "@types/sockjs": "^0.3.36",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": ">=6.16.0",
    "esbuild": "^0.28.1",
    "vite": "^6.4.3",
    "uuid": "^11.1.1",
    "nanoid": ">=3.3.18"
  },
  "private": true
}
