{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "ecommerce-vertex",
      "public": "dist/ecommerce-vertex/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "index.html",
        "**/index.html"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
          ]
        },
        {
          "source": "**/*.@(js|css|woff2|woff|ttf|eot|svg|ico|png|jpg|webp|avif)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "function": "storefrontSeo"
        }
      ]
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["npm run build:fn"]
  }
}
