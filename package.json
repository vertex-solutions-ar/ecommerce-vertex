{
  "name": "ecommerce-vertex",
  "version": "0.9.3",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "setup:credentials": "tsx scripts/setup-credentials.ts",
    "start": "ng serve --port 4201",
    "build": "ng build --configuration production",
    "test": "ng test --watch=false --code-coverage",
    "fix": "eslint src --fix && prettier --write \"src/**/*.{ts,html,scss}\"",
    "qa": "tsx scripts/qa.ts",
    "qa:full": "tsx scripts/qa.ts --full",
    "verify:flows": "tsx scripts/verify-flows.ts",
    "security:scan": "npm audit --audit-level=moderate",
    "e2e": "cypress run --e2e",
    "e2e:open": "cypress open --e2e",
    "e2e:ci": "cypress run --e2e --browser chrome",
    "test:integration": "playwright test --config integration-tests/playwright.config.ts",
    "test:integration:ui": "playwright test --ui --config integration-tests/playwright.config.ts",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "deploy:dev": "npm run clean && npm run build:dev-template && npm run build:fn && firebase deploy --project development --only hosting:ecommerce-vertex,functions",
    "deploy:prod": "npm run clean && npm run build && npm run build:fn && firebase deploy --project production --only hosting:ecommerce-vertex,functions",
    "clean": "rm -rf dist functions/lib coverage",
    "prepare": "husky",
    "lint": "eslint src",
    "prebuild": "npm --prefix ./packages/shared-contracts run build --if-present",
    "prebuild:dev": "npm --prefix ./packages/shared-contracts run build --if-present",
    "prebuild:dev-template": "npm --prefix ./packages/shared-contracts run build --if-present",
    "pretest": "npm --prefix ./packages/shared-contracts run build --if-present",
    "pretest:ci": "npm --prefix ./packages/shared-contracts run build --if-present",
    "pretypecheck": "npm --prefix ./packages/shared-contracts run build --if-present",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build:dev": "ng build --configuration development",
    "build:dev-template": "ng build --configuration dev-template --optimization --no-source-map",
    "build:fn": "npm --prefix functions run build",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/fire": "^20.1.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@popperjs/core": "^2.11.8",
    "@vertex/contracts": "file:./packages/shared-contracts",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "firebase": "^11.10.0",
    "heic2any": "^0.0.4",
    "ngx-quill": "^31.0.0",
    "quill": "2.0.3",
    "rxjs": "^7.8.2",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.8.1",
    "zod": "^4.6.5",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@clack/prompts": "^1.8.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.61.1",
    "cypress": "^15.21.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.31.0",
    "http-proxy-agent": "^9.1.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "cypress/**/*.ts": [
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "ci",
          "chore",
          "revert"
        ]
      ],
      "type-case": [
        2,
        "always",
        "lowercase"
      ],
      "type-empty": [
        2,
        "never"
      ],
      "scope-case": [
        2,
        "always",
        "lowercase"
      ],
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ],
      "subject-empty": [
        2,
        "never"
      ],
      "subject-full-stop": [
        2,
        "never",
        "."
      ],
      "subject-exclamation-mark": [
        2,
        "never"
      ],
      "header-max-length": [
        2,
        "always",
        72
      ],
      "body-leading-blank": [
        2,
        "always"
      ],
      "footer-leading-blank": [
        2,
        "always"
      ],
      "footer-token-reference": [
        2,
        "always"
      ]
    }
  },
  "overrides": {
    "@angular/fire": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser": "$@angular/platform-browser",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic",
      "@angular/compiler": "$@angular/compiler",
      "rxjs": "$rxjs",
      "firebase-tools": "$firebase-tools"
    },
    "protobufjs": ">=7.5.8",
    "@protobufjs/utf8": ">=1.1.1",
    "ws": ">=8.20.1",
    "follow-redirects": ">=1.16.0",
    "postcss": ">=8.5.10",
    "fast-xml-parser": ">=5.7.0",
    "fast-uri": ">=4.1.4",
    "http-proxy-middleware": "^4.1.1",
    "piscina": "^5.2.0",
    "@babel/core": "^7.29.7",
    "qs": ">=6.16.0",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1",
    "vite": "^7.3.4",
    "webpack-dev-server": ">=5.2.5",
    "js-yaml": ">=4.3.0",
    "image-size": ">=2.0.2",
    "@opentelemetry/core": ">=2.8.0",
    "nanoid": ">=3.3.18",
    "brace-expansion": "1.1.18"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
